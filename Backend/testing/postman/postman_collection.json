{
    "info": {
        "name": "ArchiveKKN API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:5000"
        },
        {
            "key": "username",
            "value": "admin"
        },
        {
            "key": "password",
            "value": "strongpassword"
        },
        {
            "key": "token",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const json = pm.response.json();",
                                    "const token = json?.data?.access_token;",
                                    "if (token) { pm.collectionVariables.set('token', token); }"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Projects",
            "item": [
                {
                    "name": "List Projects",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/projects/",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projects",
                                ""
                            ]
                        }
                    }
                },
                {
                    "name": "Get Project Detail",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/projects/{{projectId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projects",
                                "{{projectId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Create Project",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"title\": \"Digitalisasi Tata Kelola Desa\",\n  \"description\": \"Empowering the local community...\",\n  \"status\": \"IN PROGRESS\",\n  \"start_date\": \"2026-07-15\",\n  \"end_date\": \"2026-08-30\",\n  \"location\": \"Desa Sukamaju, West Java\",\n  \"volunteer_count\": 15,\n  \"photo_url\": \"https://example.com/photo.jpg\",\n  \"materials\": [\n    {\n      \"item_name\": \"Wireless Routers\",\n      \"quantity\": 3,\n      \"unit\": \"PCS\",\n      \"estimated_price\": 450000,\n      \"total_cost\": 1350000\n    }\n  ],\n  \"tools\": [\n    {\n      \"icon_id\": 1,\n      \"name\": \"Cable Crimper\",\n      \"category\": \"Networking\"\n    }\n  ],\n  \"sourcing_locations\": [\n    {\n      \"store_name\": \"Toko Elektronik Makmur\",\n      \"address\": \"Jl. Raya Provinsi No. 12, Sukamaju\",\n      \"distance_km\": 2.5,\n      \"provides\": \"Routers, Switches\",\n      \"google_maps_url\": \"https://maps.google.com\"\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/projects/",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projects",
                                ""
                            ]
                        }
                    }
                },
                {
                    "name": "Update Project",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            },
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"status\": \"DONE\",\n  \"volunteer_count\": 20\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/api/projects/{{projectId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projects",
                                "{{projectId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Delete Project",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}/api/projects/{{projectId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "projects",
                                "{{projectId}}"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Icons",
            "item": [
                {
                    "name": "List Icons",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/icons/",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "icons",
                                ""
                            ]
                        }
                    }
                },
                {
                    "name": "Get Icon Detail",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/api/icons/{{iconId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "api",
                                "icons",
                                "{{iconId}}"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}